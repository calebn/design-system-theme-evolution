[
  {
    "name": "Button",
    "directoryName": "button",
    "tier": "primitive",
    "functionalCategory": "actions",
    "description": "Standard labelled action button covering primary, secondary, tertiary, and stateful variants.",
    "htmlElement": "button",
    "figmaSources": [
      "Button",
      "Category Button",
      "Floating Action Button with Text",
      "Stateful Action Button"
    ],
    "props": [
      {
        "name": "variant",
        "type": "'primary' | 'secondary' | 'tertiary' | 'stateful'",
        "figmaAxis": "Type",
        "default": "primary",
        "description": "Visual hierarchy — never use color/appearance words. primary/secondary are implemented; tertiary and stateful are proposed.",
        "proposed": true
      },
      {
        "name": "scale",
        "type": "'sm' | 'md' | 'lg'",
        "figmaAxis": "Size",
        "default": "md",
        "description": "Size — always a separate prop, never encoded in variant"
      },
      {
        "name": "state",
        "type": "'default' | 'hover' | 'active' | 'disabled' | 'loading' | 'success'",
        "figmaAxis": "State",
        "default": "default"
      }
    ]
  },
